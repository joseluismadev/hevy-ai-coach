# Este archivo sirve como plantilla para variables de entorno
# Copia este contenido a un archivo .env y rellena tus valores reales

# Clave de la API de Hevy (Ajustes > Developer en la web de Hevy, requiere Pro)
HEVY_API_KEY=

# LLM: cualquier proveedor compatible con la API de OpenAI
# Gemini (gratis): clave en https://aistudio.google.com
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
